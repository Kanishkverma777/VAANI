# ==========================================
# Root Monorepo Git Ignore
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env

# Backend Python
backend/.venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/build/
backend/dist/
backend/*.egg-info/
backend/.pytest_cache/
backend/.ruff_cache/
.coverage
htmlcov/

# Frontend Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/tsconfig.tsbuildinfo
.next/
node_modules/

# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local data & uploads
backend/uploads/
backend/qdrant_storage/
backend/data/
uploads/
