# VoiceForge AI Backend Environment Configuration

# Core Application Settings
APP_NAME=VoiceForge AI Backend
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security and Authentication
AUTH_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=voiceforge
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs Conversational AI Integration
ELEVENLABS_API_KEY=

# Vector Database (Qdrant) Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voiceforge_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Limits
MAX_UPLOAD_SIZE_MB=10
MAX_PROMPT_LENGTH=5000
