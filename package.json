{
  "name": "ai-voice",
  "version": "1.0.0",
  "private": true,
  "description": "VAANI - No-Code Conversational Voice AI Platform",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "dev:backend": "cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "test:backend": "cd backend && .venv/bin/pytest -v",
    "test:frontend": "cd frontend && npx tsc --noEmit"
  }
}
